<?xml version="1.0"?>
<ruleset name="BuddyPress Job Manager">
	<description>WordPress coding standards for BuddyPress Job Manager.</description>

	<file>.</file>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<!-- Generated by `wp i18n make-php`; not hand-maintained source. -->
	<exclude-pattern>*/languages/*.l10n.php</exclude-pattern>
	<!-- Static-analysis only, never loaded by WordPress. -->
	<exclude-pattern>phpstan-bootstrap.php</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<rule ref="WordPress"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.0-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="bp-job-manager"/>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array" value="bpjm,Bpjm,BPJM,bp_job_manager,Bp_Job_Manager,BP_Job_Manager"/>
		</properties>
	</rule>
</ruleset>
