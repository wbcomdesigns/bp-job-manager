#: includes/admin/views/settings-general.php:160
msgid "Show the latest resume on the member's BuddyPress profile"
msgstr "Mostra il curriculum più recente sul profilo BuddyPress del membro"

#: includes/admin/views/settings-general.php:171
msgid "Send the job author a BuddyPress notification when someone applies"
msgstr ""
"Invia all'autore del lavoro una notifica BuddyPress quando qualcuno si "
"candida"

#: includes/admin/views/settings-general.php:183
msgid "More options unlock with the WP Job Manager add-ons."
msgstr "Altre opzioni si sbloccano con i componenti aggiuntivi di WP Job Manager."

#: includes/admin/views/settings-general.php:184
msgid ""
"Install the Resume Manager and Applications add-ons to manage resumes on "
"profiles and notify job authors about new applications."
msgstr ""
"Installa i componenti aggiuntivi Resume Manager e Applications per gestire "
"i curriculum sui profili e notificare agli autori dei lavori le nuove "
"candidature."

