msgstr ""
"Entscheide, was im BuddyPress Aktivitätsfeed angezeigt wird und welche "
"Benachrichtigungen Mitglieder erhalten."

#: includes/admin/views/settings-general.php:147
msgid "Post job activity"
msgstr "Stellenausschreibungsaktivität posten"

#: includes/admin/views/settings-general.php:151
