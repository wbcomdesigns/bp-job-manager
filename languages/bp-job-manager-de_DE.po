msgstr ""
"Füge ein BuddyPress-Aktivitätsupdate hinzu, wenn ein Mitglied einen "
"Lebenslauf veröffentlicht"

#: includes/admin/views/settings-general.php:170
msgid "Show the latest resume on the member's BuddyPress profile"
msgstr "Zeige den neuesten Lebenslauf im BuddyPress-Profil des Mitglieds"

#: includes/admin/views/settings-general.php:181
