{
	"name": "wbcom/bp-job-manager",
	"description": "Brings WP Job Manager into BuddyPress member profiles.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.0"
	},
	"config": {
		"optimize-autoloader": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^6.9",
		"phpstan/phpstan": "^2.0",
		"squizlabs/php_codesniffer": "^3.9",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.0"
	},
	"scripts": {
		"phpstan": "phpstan analyse --memory-limit=1G",
		"phpcs": "phpcs --standard=phpcs.xml.dist",
		"make-pot": "wp i18n make-pot . languages/bp-job-manager.pot --domain=bp-job-manager --exclude=node_modules,dist,audit",
		"make-mo": "wp i18n make-mo languages languages",
		"make-php": "wp i18n make-php languages languages",
		"i18n": [
			"@make-pot",
			"@make-mo",
			"@make-php"
		]
	}
}
